<?xml version="1.0" encoding="utf-8"?>
<HospitalTrafficControl>
  <RoomTransit>
    <!-- Boolean true/false. Default: false. false preserves vanilla routing; true discourages shortcuts through functional rooms. -->
    <AvoidRoomShortcuts>false</AvoidRoomShortcuts>

    <!-- Number 0-1000 using "." as decimal separator. Default: 8. Extra movement cost applied only when AvoidRoomShortcuts=true. -->
    <RoomTransitPenalty>8</RoomTransitPenalty>

    <!-- Each Room requires a non-empty ID and Enabled=true/false. Defaults: corridor, waiting and reception enabled. Enabled rooms keep vanilla movement cost; outdoor, unzoned, start and destination rooms are always exempt. -->
    <Exceptions>
      <Room ID="ROOM_TYPE_CORRIDOR" Enabled="true" />
      <Room ID="ROOM_TYPE_WAITING" Enabled="true" />
      <Room ID="ROOM_TYPE_RECEPTION" Enabled="true" />
    </Exceptions>
  </RoomTransit>

  <JanitorCleaning>
    <!-- Boolean true/false. Default: false (vanilla cleaning). true gives patients priority in short clinical rooms; hospitalization rooms remain cleanable and operating rooms stay protected when reserved or active. -->
    <AvoidCleaningActiveProcedureRooms>false</AvoidCleaningActiveProcedureRooms>

    <!-- Boolean true/false. Default: false (vanilla cleaning). true prevents janitors from selecting or entering an occupied WC compartment; a single-WC room is treated as one exclusive sanitary space while its bathroom flow is active. -->
    <AvoidCleaningOccupiedBathrooms>false</AvoidCleaningOccupiedBathrooms>

    <!-- Integer 0-100 percent. Default: 30. Chance to wait outside a dirty clinical room occupied by a patient after normal free-room work in the janitor's department fails and before vanilla's floor-wide indoor-tile fallback. -->
    <JanitorOccupiedRoomWaitChance>30</JanitorOccupiedRoomWaitChance>

    <!-- Integer 0-240 in-game minutes. Default: 30. Cooldown starts after a real exterior wait ends; a refused decision remains remembered for the same janitor, room and occupant, and a failed approach does not consume the cooldown. -->
    <JanitorOccupiedRoomWaitCooldownMinutes>30</JanitorOccupiedRoomWaitCooldownMinutes>

    <!-- Integer 0-240 in-game minutes. Default: 15. Maximum exterior wait; the room is rechecked and cleaning resumes early if it becomes free. 0 skips the stationary wait. -->
    <JanitorOccupiedRoomWaitMinutes>15</JanitorOccupiedRoomWaitMinutes>

    <!-- Integer 0-60 in-game minutes. Default: 3. Plus/minus variation chosen once when the wait starts; defaults produce a 12-18 minute wait. -->
    <JanitorOccupiedRoomWaitRandomnessMinutes>3</JanitorOccupiedRoomWaitRandomnessMinutes>

    <!-- Boolean true/false. Default: false (vanilla hospitalization-room priority). true strongly deprioritizes ordinary cleaning in occupied hospitalization rooms during NIGHT; blood remains urgent. -->
    <ReduceOccupiedHospitalizationCleaningAtNight>false</ReduceOccupiedHospitalizationCleaningAtNight>
  </JanitorCleaning>

  <BathroomFlow>
    <!-- Boolean true/false. Default: false (vanilla owner lifetime). true releases a toilet ProcedureScript owner after physical use in shared/multi-WC rooms; single-WC rooms remain exclusive through WC + sink + dryer, including collapse protection. -->
    <ReleaseToiletOwnerAfterUse>false</ReleaseToiletOwnerAfterUse>
  </BathroomFlow>

  <Debug>
    <!-- Boolean true/false. Default: false. true logs final NoPath jobs and the inaccessible transitions tested by the final PathfinderJob. -->
    <PathfindingDebug>false</PathfindingDebug>

    <!-- Boolean true/false. Default: false. true logs focused janitor/cart state, destination, room and cart changes, including nighttime-priority decisions. -->
    <JanitorCartDebug>false</JanitorCartDebug>

    <!-- Boolean true/false. Default: false. true logs Shift+click door selection/group data and OneWay arrow destination/render coordinates. -->
    <DoorDebug>false</DoorDebug>

    <!-- Boolean true/false. Default: false. true audits WC locks and lavabo/dryer handoffs. -->
    <BathroomFlowDebug>false</BathroomFlowDebug>
  </Debug>
</HospitalTrafficControl>
