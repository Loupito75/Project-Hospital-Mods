<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Loupito75.HospitalFixes</AssemblyName>
    <RootNamespace>HospitalFixes</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateFullPaths>false</GenerateFullPaths>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Authors>Loupito75</Authors>
    <Company>Loupito75</Company>
    <Product>Hospital Fixes</Product>
    <Description>Fixes targeted Vanilla bugs and inconsistencies in Project Hospital across hospital operations, interface, construction and visuals.</Description>
    <GameDir Condition="'$(GameDir)' == '' and '$(PROJECT_HOSPITAL_DIR)' != ''">$(PROJECT_HOSPITAL_DIR)</GameDir>
    <ManagedDir Condition="'$(GameDir)' != ''">$(GameDir)\ProjectHospital_Data\Managed</ManagedDir>
    <BepInExDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\core</BepInExDir>
    <PluginDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\plugins\Loupito75.HospitalFixes</PluginDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="FixConfig.cs" />
    <Compile Include="Diagnostics.cs" />
    <Compile Include="HfxDatabase.cs" />
    <Compile Include="LocalizationManager.cs" />
    <Compile Include="Patches\EmployeeDayStartPatch.cs" />
    <Compile Include="Patches\HiringPerkRevealPatch.cs" />
    <Compile Include="Patches\MobileGhostPatch.cs" />
    <Compile Include="Patches\CustomCharacterAgePatch.cs" />
    <Compile Include="Patches\MovingObjectLightingPatch.cs" />
    <Compile Include="Patches\TransparencyPreferencesPatch.cs" />
    <Compile Include="Patches\PauseAfterLoadingSavePatch.cs" />
    <Compile Include="Patches\BlockedMobileEquipmentPatch.cs" />
    <Compile Include="Patches\ElevatorExteriorDecorationsPatch.cs" />
    <Compile Include="Patches\OutpatientWaitingRoomRecoveryPatch.cs" />
    <Compile Include="Patches\ObservationReadmissionPatch.cs" />
    <Compile Include="Patches\HospitalBedConsistencyPatch.cs" />
    <Compile Include="Patches\WallObjectPlacementConflictsPatch.cs" />
    <Compile Include="Patches\LabCompositeWallOverlapPatch.cs" />
    <Compile Include="Patches\WaitingRoomNotificationTextPatch.cs" />
    <Compile Include="Patches\PopupTextOverflowPatch.cs" />
    <Compile Include="Patches\SupervisorDisplayPatch.cs" />
    <Compile Include="Patches\PatientListHeadingPatch.cs" />
    <Compile Include="Patches\EmployeeLevelDisplayPatch.cs" />
    <Compile Include="Patches\WorkspaceEmployeeSelectionPatch.cs" />
    <Compile Include="Patches\JanitorDuplicateCleaningPatch.cs" />
    <Compile Include="Patches\HospitalizedProcedureEquipmentSelectionPatch.cs" />
    <Compile Include="Patches\ReservedStaffWaitingVisualsPatch.cs" />
    <Compile Include="Patches\ReservedStaffWaitingBubbleRendererPatch.cs" />
    <Compile Include="Patches\CharacterVisualDepthPatch.cs" />
    <Compile Include="Patches\CharacterVisualDepthDiagnosticsPatch.cs" />
    <Compile Include="Patches\OutpatientExamClothingSequencePatch.cs" />
    <Compile Include="Patches\PatientClothingChangeAnimationPatch.cs" />
    <Compile Include="Patches\ClothingChangeAnimationFactory.cs" />
    <Compile Include="Patches\ClothingChangeEffectRenderer.cs" />
    <Compile Include="Patches\HshStaffClothingChangeIntegration.cs" />
    <ModAnimatedModelFiles Include="AnimatedModels\**\*" />
    <ModDatabaseFiles Include="Database\**\*" />
    <ModTextureFiles Include="Textures\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameDir)' != ''">
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(ManagedDir)\UnityEngine.dll')"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI" Condition="Exists('$(ManagedDir)\UnityEngine.UI.dll')"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Condition="Exists('$(ManagedDir)\UnityEngine.TextRenderingModule.dll')"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule" Condition="Exists('$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll')"><HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestWWWModule" Condition="Exists('$(ManagedDir)\UnityEngine.UnityWebRequestWWWModule.dll')"><HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestWWWModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateProjectHospitalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="GameDir is required. Use build.ps1, set PROJECT_HOSPITAL_DIR, or pass /p:GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(BepInExDir)\BepInEx.dll')" Text="BepInEx.dll not found." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(BepInExDir)\0Harmony.dll')" Text="0Harmony.dll not found." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.dll') AND !Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')" Text="UnityEngine core assembly not found." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.UI.dll')" Text="UnityEngine.UI.dll not found." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.TextRenderingModule.dll')" Text="UnityEngine.TextRenderingModule.dll not found." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll')" Text="UnityEngine.UnityWebRequestModule.dll not found." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.UnityWebRequestWWWModule.dll')" Text="UnityEngine.UnityWebRequestWWWModule.dll not found." />
  </Target>
  <Target Name="CopyPluginToGame" AfterTargets="Build" Condition="'$(PluginDir)' != ''">
    <MakeDir Directories="$(PluginDir)" />
    <MakeDir Directories="$(PluginDir)\AnimatedModels" />
    <MakeDir Directories="$(PluginDir)\Database" />
    <MakeDir Directories="$(PluginDir)\Textures\UI" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Loupito75.HospitalFixes.Config.xml" DestinationFolder="$(PluginDir)" Condition="!Exists('$(PluginDir)\Loupito75.HospitalFixes.Config.xml')" />
    <Copy SourceFiles="@(ModAnimatedModelFiles)"
          DestinationFiles="@(ModAnimatedModelFiles->'$(PluginDir)\AnimatedModels\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(ModAnimatedModelFiles)' != ''" />
    <Copy SourceFiles="@(ModDatabaseFiles)"
          DestinationFiles="@(ModDatabaseFiles->'$(PluginDir)\Database\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(ModDatabaseFiles)' != ''" />
    <Copy SourceFiles="@(ModTextureFiles)"
          DestinationFiles="@(ModTextureFiles->'$(PluginDir)\Textures\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(ModTextureFiles)' != ''" />
  </Target>
</Project>
