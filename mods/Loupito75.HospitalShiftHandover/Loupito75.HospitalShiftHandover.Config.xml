<?xml version="1.0" encoding="utf-8"?>
<HospitalShiftHandover>
  <Arrival>
    <!-- Integer minutes. Valid range: 15-180. Minimum planned pre-shift commute lead for non-late staff. This is HSH behavior, not a vanilla setting. -->
    <PlannedCommuteLeadMinMinutes>65</PlannedCommuteLeadMinMinutes>

    <!-- Integer minutes. Valid range: 15-180. Maximum planned pre-shift commute lead for non-late staff. Must be >= PlannedCommuteLeadMinMinutes. This is HSH behavior, not a vanilla setting. -->
    <PlannedCommuteLeadMaxMinutes>80</PlannedCommuteLeadMaxMinutes>

    <!-- Integer minutes. Valid range: 0-120. Extra lead added by HSH to the game's own early-commute timing. Set to 0 to remove only this HSH extension and stay closest to vanilla commute timing. -->
    <NativeEarlyExtensionMinutes>15</NativeEarlyExtensionMinutes>
  </Arrival>

  <Dressing>
    <!-- Boolean: true or false only. true enables HSH locker/civilian-clothes handling. false disables HSH dressing and keeps the game's normal work-clothing behavior. -->
    <DressingEnabled>false</DressingEnabled>

    <!-- Integer percentage. Valid range: 0-100. Chance that an eligible arriving employee uses the HSH locker dressing flow when DressingEnabled=true. 0=never, 100=always. -->
    <ArrivalDressingChancePercent>70</ArrivalDressingChancePercent>

    <!-- Integer percentage. Valid range: 0-100. Chance that an eligible outgoing employee changes before leaving when DressingEnabled=true. 0=never, 100=always. Staff never wait after shift for an occupied locker. -->
    <OutgoingDressingChancePercent>40</OutgoingDressingChancePercent>

    <!-- Integer percentage. Valid range: 0-100. Among HSH civilian outfits, chance to use the casual family; the remainder uses business clothes. 0=all business, 100=all casual. -->
    <CasualClothesPercent>65</CasualClothesPercent>
  </Dressing>

  <PreShiftActivities>
    <!-- Boolean: true or false only. true allows HSH to assist an existing real staff need toward the game's native CheckNeeds threshold when enough pre-shift time remains. false disables only this HSH assistance; normal vanilla needs still work. -->
    <AssistedNeedsEnabled>true</AssistedNeedsEnabled>

    <!-- Integer percentage. Valid range: 0-100. Per eligible employee/shift chance to use HSH assisted needs when AssistedNeedsEnabled=true. 0=never assist, 100=always attempt when otherwise eligible. -->
    <AssistedNeedChancePercent>65</AssistedNeedChancePercent>

    <!-- Boolean: true or false only. true allows the game's native staff free-time procedure during HSH's pre-shift common-room window. false disables only pre-shift free-time managed by HSH; it does not disable vanilla free-time during normal work behavior. -->
    <FreeTimeEnabled>true</FreeTimeEnabled>
  </PreShiftActivities>

  <LateRelief>
    <!-- Boolean: true or false only. true lets an outgoing idle employee remain briefly when the exact opposite-shift relief for the same workplace is absent. false returns to vanilla-like departure as soon as the employee is free after shift. -->
    <LateReliefEnabled>true</LateReliefEnabled>

    <!-- Integer minutes. Valid range: 0-120. Minimum late-relief timeout measured from the official end of the employee's shift. Set both min and max to 0 to disable any grace duration while keeping LateReliefEnabled=true. -->
    <LateReliefMinimumMinutes>15</LateReliefMinimumMinutes>

    <!-- Integer minutes. Valid range: 0-120. Maximum late-relief timeout measured from official shift end. Must be >= LateReliefMinimumMinutes. Each employee/day gets a stable value inside the range. Ongoing professional work is never interrupted. -->
    <LateReliefMaximumMinutes>30</LateReliefMaximumMinutes>
  </LateRelief>

  <Diagnostics>
    <!-- Boolean: true or false only. true enables concise HSH troubleshooting traces in BepInEx\LogOutput.log. false is recommended for normal play. Invalid values make HSH fall back to its built-in configuration defaults. -->
    <DiagnosticsEnabled>false</DiagnosticsEnabled>
  </Diagnostics>
</HospitalShiftHandover>
