<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Loupito75.HospitalShiftHandover</AssemblyName>
    <RootNamespace>HospitalShiftHandover</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateFullPaths>false</GenerateFullPaths>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0</AssemblyVersion>
    <FileVersion>1.2.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <Authors>Loupito75</Authors>
    <Company>Loupito75</Company>
    <Product>Hospital Shift Handover</Product>
    <Description>Makes staff arrivals, shift changes and handovers more natural and realistic.</Description>

    <GameDir Condition="'$(GameDir)' == '' and '$(PROJECT_HOSPITAL_DIR)' != ''">$(PROJECT_HOSPITAL_DIR)</GameDir>
    <ManagedDir Condition="'$(GameDir)' != ''">$(GameDir)\ProjectHospital_Data\Managed</ManagedDir>
    <BepInExDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\core</BepInExDir>
    <PluginDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\plugins\Loupito75.HospitalShiftHandover</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="ShiftHandoverConfig.cs" />
    <Compile Include="HandoverPatches.cs" />
    <Compile Include="PreShiftHandoverSeatGuardPatch.cs" />
    <Compile Include="PreShiftNeedVanillaParityPatch.cs" />
    <Compile Include="PreShiftArrival.cs" />
    <Compile Include="PreShiftCoordinator.cs" />
    <Compile Include="PreShiftCommonAreaController.cs" />
    <Compile Include="PreShiftLockerInteraction.cs" />
    <Compile Include="PreShiftVisuals.cs" />
    <Compile Include="PreShiftNeedEngine.cs" />
    <Compile Include="OrganicStaging.cs" />
    <Compile Include="OutgoingHandover.cs" />
    <Compile Include="WorkplaceTravelEstimator.cs" />
  </ItemGroup>

  <ItemGroup>
    <ModDatabaseFiles Include="Database\**\*.xml" />
    <ModTextureFiles Include="Textures\**\*.png" />
    <None Include="Loupito75.HospitalShiftHandover.Config.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameDir)' != ''">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(ManagedDir)\UnityEngine.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateProjectHospitalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="GameDir is required." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(BepInExDir)\BepInEx.dll')" Text="BepInEx.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(BepInExDir)\0Harmony.dll')" Text="0Harmony.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.dll') AND !Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')" Text="No required UnityEngine assembly was found under the configured GameDir." />
  </Target>

  <Target Name="CopyPluginToGame" AfterTargets="Build" Condition="'$(PluginDir)' != ''">
    <MakeDir Directories="$(PluginDir)" />
    <MakeDir Directories="$(PluginDir)\Database" />
    <MakeDir Directories="$(PluginDir)\Textures" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Copy SourceFiles="@(ModDatabaseFiles)"
          DestinationFiles="@(ModDatabaseFiles->'$(PluginDir)\Database\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ModTextureFiles)"
          DestinationFiles="@(ModTextureFiles->'$(PluginDir)\Textures\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Loupito75.HospitalShiftHandover.Config.xml"
          DestinationFolder="$(PluginDir)"
          Condition="!Exists('$(PluginDir)\Loupito75.HospitalShiftHandover.Config.xml')" />
  </Target>
</Project>
