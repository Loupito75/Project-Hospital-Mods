<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Loupito75.HospitalPorters</AssemblyName>
    <RootNamespace>HospitalPorters</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateFullPaths>false</GenerateFullPaths>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1</AssemblyVersion>
    <FileVersion>1.0.1</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <Authors>Loupito75</Authors>
    <Company>Loupito75</Company>
    <Product>Hospital Porters</Product>
    <Description>Project Hospital porter and internal transport mod powered by BepInEx and Harmony.</Description>

    <GameDir Condition="'$(GameDir)' == '' and '$(PROJECT_HOSPITAL_DIR)' != ''">$(PROJECT_HOSPITAL_DIR)</GameDir>
    <ManagedDir Condition="'$(GameDir)' != ''">$(GameDir)\ProjectHospital_Data\Managed</ManagedDir>
    <BepInExDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\core</BepInExDir>
    <PluginDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\plugins\Loupito75.HospitalPorters</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="PorterTransportConfig.cs" />
    <Compile Include="PorterDiagnostics.cs" />
    <Compile Include="PorterRuntime.cs" />
    <Compile Include="PorterVisuals.cs" />
    <Compile Include="PorterCustomAssetPatches.cs" />
    <Compile Include="LocalizationManager.cs" />
    <Compile Include="PorterPatches.cs" />
    <Compile Include="PorterSampleTransportPatches.cs" />
    <Compile Include="PorterSampleCartPatches.cs" />
    <Compile Include="PorterSamplePersistencePatches.cs" />
    <Compile Include="PorterSampleStatusPatches.cs" />
    <Compile Include="PorterIdlePatches.cs" />
    <Compile Include="PorterStaffTooltipPatches.cs" />
    <Compile Include="PorterStationPatches.cs" />
    <Compile Include="PorterLogisticsPatches.cs" />
    <Compile Include="PorterHospitalizationLayout.cs" />
    <Compile Include="PorterDepartmentStaffingPatches.cs" />
    <Compile Include="PorterDepartmentHeadingIconPatch.cs" />
    <Compile Include="PorterHiringStationGuardPatches.cs" />
    <Compile Include="PorterNativeHiringPatches.cs" />
    <Compile Include="PorterNativeEmployeeUiPatches.cs" />
    <Compile Include="PorterEmployeeCardPatches.cs" />
    <Compile Include="PorterHiringInitialSelectionPatch.cs" />
    <Compile Include="Porter046Patches.cs" />
    <Compile Include="Porter049Patches.cs" />
    <Compile Include="Porter0412UiPatches.cs" />
    <Compile Include="PorterNativeSelectionPatches.cs" />
    <Compile Include="HiringPatches.cs" />
    <Compile Include="HiringUiIconPatches.cs" />
    <ModDatabaseFiles Include="Database\**\*.xml" />
    <ModTextureFiles Include="Textures\**\*.png" />
    <ModConfigFiles Include="Loupito75.HospitalPorters.Config.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameDir)' != ''">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(ManagedDir)\UnityEngine.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI" Condition="Exists('$(ManagedDir)\UnityEngine.UI.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Condition="Exists('$(ManagedDir)\UnityEngine.TextRenderingModule.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateProjectHospitalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''"
           Text="GameDir is required. Use build.ps1, set PROJECT_HOSPITAL_DIR locally, or pass /p:GameDir at build time." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(BepInExDir)\BepInEx.dll')"
           Text="BepInEx.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(BepInExDir)\0Harmony.dll')"
           Text="0Harmony.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.dll') AND !Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')"
           Text="No required UnityEngine assembly was found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.UI.dll')"
           Text="UnityEngine.UI.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.TextRenderingModule.dll')"
           Text="UnityEngine.TextRenderingModule.dll was not found under the configured GameDir." />
  </Target>

  <Target Name="CopyPluginToGame" AfterTargets="Build" Condition="'$(PluginDir)' != ''">
    <MakeDir Directories="$(PluginDir)" />
    <MakeDir Directories="$(PluginDir)\Database" />
    <MakeDir Directories="$(PluginDir)\Textures" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Copy SourceFiles="@(ModDatabaseFiles)"
          DestinationFiles="@(ModDatabaseFiles->'$(PluginDir)\Database\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ModTextureFiles)"
          DestinationFiles="@(ModTextureFiles->'$(PluginDir)\Textures\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ModConfigFiles)" DestinationFolder="$(PluginDir)" />
  </Target>
</Project>