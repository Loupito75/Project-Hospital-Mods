<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Loupito75.HospitalModUpdateChecker</AssemblyName>
    <RootNamespace>HospitalModUpdateChecker</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateFullPaths>false</GenerateFullPaths>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Authors>Loupito75</Authors>
    <Company>Loupito75</Company>
    <Product>Hospital Mod Update Checker</Product>
    <Description>Project Hospital mod update notification checker powered by BepInEx and Harmony.</Description>

    <GameDir Condition="'$(GameDir)' == '' and '$(PROJECT_HOSPITAL_GAME_DIR)' != ''">$(PROJECT_HOSPITAL_GAME_DIR)</GameDir>
    <ManagedDir Condition="'$(GameDir)' != ''">$(GameDir)\ProjectHospital_Data\Managed</ManagedDir>
    <BepInExDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\core</BepInExDir>
    <PluginDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\plugins\Loupito75.HospitalModUpdateChecker</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="UpdateChecker.cs" />
    <Compile Include="UpdateCheckerConfig.cs" />
    <Compile Include="UpdateManifest.cs" />
    <Compile Include="SimpleJsonParser.cs" />
    <Compile Include="TitleScreenPatches.cs" />
    <Compile Include="TitleScreenUpdatePanel.cs" />
    <Compile Include="UpdatePanelLocalization.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Loupito75.HospitalModUpdateChecker.Config.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameDir)' != ''">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(ManagedDir)\UnityEngine.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateProjectHospitalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''"
           Text="GameDir is required. Use build.ps1, set PROJECT_HOSPITAL_GAME_DIR locally, or pass /p:GameDir=&lt;PROJECT_HOSPITAL_DIR&gt;." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(BepInExDir)\BepInEx.dll')"
           Text="BepInEx.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(BepInExDir)\0Harmony.dll')"
           Text="0Harmony.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')"
           Text="UnityEngine.CoreModule.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.UI.dll')"
           Text="UnityEngine.UI.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.UIModule.dll')"
           Text="UnityEngine.UIModule.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.TextRenderingModule.dll')"
           Text="UnityEngine.TextRenderingModule.dll was not found under the configured GameDir." />
    <Error Condition="'$(GameDir)' != '' AND !Exists('$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll')"
           Text="UnityEngine.UnityWebRequestModule.dll was not found under the configured GameDir." />
  </Target>

  <Target Name="CopyPluginToGame" AfterTargets="Build" Condition="'$(PluginDir)' != ''">
    <MakeDir Directories="$(PluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
  </Target>
</Project>
