<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Loupito75.HospitalEMS</AssemblyName>
    <RootNamespace>HospitalEMS</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1</AssemblyVersion>
    <FileVersion>1.0.1</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <Authors>Loupito75</Authors>
    <Company>Loupito75</Company>
    <Product>Hospital EMS</Product>
    <Description>Project Hospital ambulance, helicopter and prehospital care mod powered by BepInEx and Harmony.</Description>

    <GameDir Condition="'$(GameDir)' == '' and '$(PROJECT_HOSPITAL_DIR)' != ''">$(PROJECT_HOSPITAL_DIR)</GameDir>
    <ManagedDir Condition="'$(GameDir)' != ''">$(GameDir)\ProjectHospital_Data\Managed</ManagedDir>
    <BepInExDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\core</BepInExDir>
    <PluginDir Condition="'$(GameDir)' != ''">$(GameDir)\BepInEx\plugins\Loupito75.HospitalEMS</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="HospitalEmsConfig.cs" />
    <Compile Include="Plugin.cs" />
    <Compile Include="PrehospitalAssessmentService.cs" />
    <Compile Include="Patches\DeliveredByAmbulancePatch.cs" />
    <Compile Include="Patches\AmbulanceAbandonedStretcherCleanupFixPatch.cs" />
    <Compile Include="Patches\OutgoingAmbulanceBedReservationFixPatch.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Loupito75.HospitalEMS.Config.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(ManagedDir)\UnityEngine.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateProjectHospitalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="GameDir is not set. Pass /p:GameDir=... or set PROJECT_HOSPITAL_DIR." />
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found. GameDir points to '$(GameDir)'." />
    <Error Condition="!Exists('$(BepInExDir)\BepInEx.dll')" Text="BepInEx.dll was not found in '$(BepInExDir)'." />
    <Error Condition="!Exists('$(BepInExDir)\0Harmony.dll')" Text="0Harmony.dll was not found in '$(BepInExDir)'." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.dll') AND !Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')" Text="No UnityEngine assembly was found in '$(ManagedDir)'." />
  </Target>

  <Target Name="CopyPluginToGame" AfterTargets="Build">
    <MakeDir Directories="$(PluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Loupito75.HospitalEMS.Config.xml"
          DestinationFolder="$(PluginDir)"
          Condition="!Exists('$(PluginDir)\Loupito75.HospitalEMS.Config.xml')" />
  </Target>
</Project>
